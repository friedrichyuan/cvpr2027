<?xml version="1.0" encoding="utf-8"?>
<robot name="dex3_hand_left">
  <!--
    Unitree G1 Dex3 left hand, extracted from g1_mocap_29dof_with_hands.xml.
    Kinematic chain only (no visual/collision meshes needed for dex-retargeting).
    Joint limits match the MJCF model exactly.
    Add dummy free joint via dex-retargeting config (add_dummy_free_joint: True).
  -->

  <!-- Base link (dummy, for free joint attachment) -->
  <link name="base"/>

  <!-- Hand base link (represents the wrist/palm) -->
  <link name="hand_base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>

  <joint name="hand_base_joint" type="fixed">
    <parent link="base"/>
    <child link="hand_base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ====== Thumb chain ====== -->
  <link name="left_hand_thumb_0_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="left_hand_thumb_0_joint" type="revolute">
    <parent link="hand_base_link"/>
    <child link="left_hand_thumb_0_link"/>
    <origin xyz="0.067 0.003 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.0472" upper="1.0472" effort="2.45" velocity="1.0"/>
  </joint>

  <link name="left_hand_thumb_1_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="left_hand_thumb_1_joint" type="revolute">
    <parent link="left_hand_thumb_0_link"/>
    <child link="left_hand_thumb_1_link"/>
    <origin xyz="-0.0025 -0.0193 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.7243" upper="1.0472" effort="1.4" velocity="1.0"/>
  </joint>

  <link name="left_hand_thumb_2_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="left_hand_thumb_2_joint" type="revolute">
    <parent link="left_hand_thumb_1_link"/>
    <child link="left_hand_thumb_2_link"/>
    <origin xyz="0 -0.0458 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="1.7453" effort="1.4" velocity="1.0"/>
  </joint>

  <!-- Thumb fingertip (fixed link for retargeting target) -->
  <link name="left_hand_thumb_finger_tip">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>

  <joint name="left_hand_thumb_tip_joint" type="fixed">
    <parent link="left_hand_thumb_2_link"/>
    <child link="left_hand_thumb_finger_tip"/>
    <origin xyz="0 -0.048 0" rpy="0 0 0"/>
  </joint>

  <!-- ====== Index finger chain ====== -->
  <link name="left_hand_index_0_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="left_hand_index_0_joint" type="revolute">
    <parent link="hand_base_link"/>
    <child link="left_hand_index_0_link"/>
    <origin xyz="0.1192 0.0046 0.0285" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="0" effort="1.4" velocity="1.0"/>
  </joint>

  <link name="left_hand_index_1_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="left_hand_index_1_joint" type="revolute">
    <parent link="left_hand_index_0_link"/>
    <child link="left_hand_index_1_link"/>
    <origin xyz="0.0458 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.7453" upper="0" effort="1.4" velocity="1.0"/>
  </joint>

  <!-- Index fingertip (fixed link for retargeting target) -->
  <link name="left_hand_index_finger_tip">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>

  <joint name="left_hand_index_tip_joint" type="fixed">
    <parent link="left_hand_index_1_link"/>
    <child link="left_hand_index_finger_tip"/>
    <origin xyz="0.048 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ====== Middle finger chain ====== -->
  <link name="left_hand_middle_0_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="left_hand_middle_0_joint" type="revolute">
    <parent link="hand_base_link"/>
    <child link="left_hand_middle_0_link"/>
    <origin xyz="0.1192 0.0046 -0.0285" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="0" effort="1.4" velocity="1.0"/>
  </joint>

  <link name="left_hand_middle_1_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="left_hand_middle_1_joint" type="revolute">
    <parent link="left_hand_middle_0_link"/>
    <child link="left_hand_middle_1_link"/>
    <origin xyz="0.0458 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.7453" upper="0" effort="1.4" velocity="1.0"/>
  </joint>

  <!-- Middle fingertip (fixed link for retargeting target) -->
  <link name="left_hand_middle_finger_tip">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>

  <joint name="left_hand_middle_tip_joint" type="fixed">
    <parent link="left_hand_middle_1_link"/>
    <child link="left_hand_middle_finger_tip"/>
    <origin xyz="0.048 0 0" rpy="0 0 0"/>
  </joint>

</robot>
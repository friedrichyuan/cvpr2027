+def _read_frames_opencv(path, frame_index):
+    """OpenCV fallback for `decord.VideoReader.get_batch`. Used on aarch64 where decord
+    has no published wheels. Reads frames one at a time — slower than decord but
+    sufficient for smoke-scale runs.
+    """
+    import cv2
+    cap = cv2.VideoCapture(str(path))
+    if not cap.isOpened():
+        raise IOError(f"OpenCV cannot open {path}")
+    out = []
+    for f in frame_index:
+        cap.set(cv2.CAP_PROP_POS_FRAMES, int(f))
+        ok, img = cap.read()
+        if not ok or img is None:
+            cap.release()
+            raise IOError(f"failed to read frame {f} from {path}")
+        out.append(cv2.cvtColor(img, cv2.COLOR_BGR2RGB))
+    cap.release()
+    return np.stack(out, axis=0)
+

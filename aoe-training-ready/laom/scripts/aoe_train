#!/usr/bin/env bash
# Open-AoE laom (LAOM) launcher: convert AoE npz to laom HDF5, then run LAOM
# pretraining inside an upstream dunnolab/laom checkout. Env-var driven (see README.md);
# the placeholders below are not real locations.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
INTEGRATION_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
UPSTREAM_ROOT="${LAOM_UPSTREAM_ROOT:-$INTEGRATION_ROOT}"

PYTHON_BIN="${LAOM_PYTHON:-python}"
NPZ_DIR="${OPEN_AOE_NPZ_DIR:-/PATH_TO/aoe_npz/aoe26}"
DATA_DIR="${LAOM_DATA_DIR:-/PATH_TO/laom_data}"
CLIP_LEN="${CLIP_LEN:-16}"
ACT_DIM="${ACT_DIM:-20}"
EPOCHS="${EPOCHS:-30}"
OUT_CSV="${OUT_CSV:-$DATA_DIR/aoe_laom_loss.csv}"
GPUS="${CUDA_VISIBLE_DEVICES:-0}"

export CUDA_VISIBLE_DEVICES="$GPUS"
export PYTHONPATH="$UPSTREAM_ROOT:$UPSTREAM_ROOT/src:$SCRIPT_DIR:${PYTHONPATH:-}"

run_or_print() {
  if [[ "${DRY_RUN:-0}" == "1" ]]; then
    printf '[dry-run]'
    printf ' %q' "$@"
    printf '\n'
  else
    "$@"
  fi
}

convert_data() {
  run_or_print "$PYTHON_BIN" "$SCRIPT_DIR/aoe_to_laom_hdf5.py" \
    --src "$NPZ_DIR" \
    --out-dir "$DATA_DIR" \
    --act-dim "$ACT_DIM" \
    --clip-len "$CLIP_LEN"
}

train_model() {
  local argv=(
    "$PYTHON_BIN" "$SCRIPT_DIR/run_laom_aoe.py"
    --data "$DATA_DIR/aoe_laom_full.hdf5"
    --labeled "$DATA_DIR/aoe_laom_labeled.hdf5"
    --epochs "$EPOCHS"
    --out "$OUT_CSV"
  )
  argv+=("$@")
  if [[ "${DRY_RUN:-0}" == "1" ]]; then
    run_or_print "${argv[@]}"
  else
    ( cd "$UPSTREAM_ROOT" && "${argv[@]}" )
  fi
}

cmd="${1:-train}"
shift || true
if [[ "$cmd" == "--dry-run" ]]; then
  DRY_RUN=1
  cmd="${1:-train}"
  shift || true
fi

case "$cmd" in
  convert) convert_data ;;
  train) train_model "$@" ;;
  *) echo "Usage: $0 [--dry-run] {convert|train}" >&2; exit 2 ;;
esac

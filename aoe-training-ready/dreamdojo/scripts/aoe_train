#!/usr/bin/env bash
# Open-AoE DreamDojo launcher. Two routes into an upstream NVIDIA/DreamDojo checkout:
#   zero-shot preview : convert AoE video -> 480x640 MP4 (generic VideoDataset), run inference.
#   MANO post-train   : build egodex HDF5 (real AoE hand actions) -> action-conditioned post-train
#                       (results pending; injects AoE MANO into the action vector [220:352]).
# Env-var driven (see README_OPEN_AOE.md); the placeholders below are not real locations.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
INTEGRATION_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
UPSTREAM_ROOT="${DREAMDOJO_UPSTREAM_ROOT:-$INTEGRATION_ROOT}"

PYTHON_BIN="${DREAMDOJO_PYTHON:-python}"
RAW_ROOT="${OPEN_AOE_RAW_ROOT:-/PATH_TO/Open-AoE/poc_deliver}"
DD_VIDEO_DIR="${DD_VIDEO_DIR:-/PATH_TO/aoe_dd_videos}"
NUM_CLIPS="${NUM_CLIPS:-3}"
FRAMES="${FRAMES:-150}"
DD_CKPT_DIR="${DD_CKPT_DIR:-/PATH_TO/hf_ckpt/2B_GR1_post-train}"
EXPERIMENT="${EXPERIMENT:-dreamdojo_2b_480_640_gr1}"
SAVE_DIR="${SAVE_DIR:-/PATH_TO/aoe_runs/dreamdojo_aoe}"
NUM_FRAMES="${NUM_FRAMES:-49}"
NUM_SAMPLES="${NUM_SAMPLES:-3}"
GPUS="${CUDA_VISIBLE_DEVICES:-0}"

# --- MANO-conditioned post-train (egodex route) ---
EGODEX_HDF5_ROOT="${AOE_EGODEX_HDF5_ROOT:-/PATH_TO/aoe_egodex_hdf5}"       # converter --out; training dataset_path
POSTTRAIN_EXPERIMENT="${POSTTRAIN_EXPERIMENT:-dreamdojo_2b_480_640_gr1}"
MAX_ITER="${MAX_ITER:-10000}"
SAVE_ITER="${SAVE_ITER:-500}"
BATCH="${BATCH:-1}"
# _VIDEO_ROOT in the patched dataset_mano.py reads this env var -> must be exported.
export AOE_EGODEX_VIDEO_ROOT="${AOE_EGODEX_VIDEO_ROOT:-/PATH_TO/aoe_egodex_videos}"  # mp4 symlinks
export IMAGINAIRE_OUTPUT_ROOT="${IMAGINAIRE_OUTPUT_ROOT:-/PATH_TO/aoe_runs/dreamdojo_posttrain}"

export CUDA_VISIBLE_DEVICES="$GPUS"
export PYTHONPATH="$UPSTREAM_ROOT:$SCRIPT_DIR:${PYTHONPATH:-}"

run_or_print() {
  if [[ "${DRY_RUN:-0}" == "1" ]]; then
    printf '[dry-run]'
    printf ' %q' "$@"
    printf '\n'
  else
    "$@"
  fi
}

convert_data() {
  run_or_print "$PYTHON_BIN" "$SCRIPT_DIR/aoe_to_dreamdojo.py" \
    --data-root "$RAW_ROOT" \
    --out-dir "$DD_VIDEO_DIR" \
    --num-clips "$NUM_CLIPS" \
    --frames "$FRAMES"
}

# Zero-shot action-conditioned inference (needs the DreamDojo env + a >=45GB GPU; see README).
infer() {
  local argv=(
    "$PYTHON_BIN" "$UPSTREAM_ROOT/examples/action_conditioned.py"
    -o "$SAVE_DIR"
    --checkpoints-dir "$DD_CKPT_DIR"
    --experiment "$EXPERIMENT"
    --save-dir "$SAVE_DIR/results"
    --num-frames "$NUM_FRAMES"
    --num-samples "$NUM_SAMPLES"
    --dataset-path "$DD_VIDEO_DIR"
    --data-split full
    --deterministic-uniform-sampling
  )
  argv+=("$@")
  if [[ "${DRY_RUN:-0}" == "1" ]]; then
    run_or_print "${argv[@]}"
  else
    ( cd "$UPSTREAM_ROOT" && "${argv[@]}" )
  fi
}

# Build MANO-conditioned egodex data: AoE hands.npz -> per-node rot6d HDF5 + paired mp4 symlink.
build_egodex() {
  run_or_print "$PYTHON_BIN" "$SCRIPT_DIR/aoe_to_dd_mano.py" \
    --data-root "$RAW_ROOT" \
    --out "$EGODEX_HDF5_ROOT" \
    --video-root "$AOE_EGODEX_VIDEO_ROOT" \
    --limit "$NUM_CLIPS"
}

# MANO-conditioned post-train (needs the DreamDojo env + >=45GB GPUs; results pending).
# The applied patch injects real AoE MANO hand actions into the action vector [220:352].
# nproc_per_node / fsdp_shard_size follow CUDA_VISIBLE_DEVICES; single-node.
posttrain() {
  local ngpu port
  ngpu="$(echo -n "$GPUS" | awk -F',' '{print ($1==""?1:NF)}')"
  port="$(( 20000 + RANDOM % 20000 ))"
  local argv=(
    torchrun --nnodes=1 --nproc_per_node="$ngpu" --master_port="$port" -m scripts.train
    --config=cosmos_predict2/_src/predict2/action/configs/action_conditioned/config.py --
    experiment="$POSTTRAIN_EXPERIMENT" job.wandb_mode=disabled
    ~dataloader_train.dataloaders
    "dataloader_train.dataset.dataset_path=[$EGODEX_HDF5_ROOT]"
    dataloader_train.batch_size="$BATCH"
    "dataloader_val.dataset.dataset_path=[$EGODEX_HDF5_ROOT]"
    dataloader_val.batch_size=1
    trainer.run_validation=False
    trainer.max_iter="$MAX_ITER"
    checkpoint.save_iter="$SAVE_ITER"
    checkpoint.load_training_state=False
    model.config.fsdp_shard_size="$ngpu"
    trainer.callbacks.compile_tokenizer.enabled=False
    ~trainer.callbacks.every_n_sample_reg ~trainer.callbacks.every_n_sample_ema
  )
  argv+=("$@")
  if [[ "${DRY_RUN:-0}" == "1" ]]; then
    run_or_print "${argv[@]}"
  else
    ( cd "$UPSTREAM_ROOT" && "${argv[@]}" )
  fi
}

cmd="${1:-convert}"
shift || true
if [[ "$cmd" == "--dry-run" ]]; then
  DRY_RUN=1
  cmd="${1:-convert}"
  shift || true
fi

case "$cmd" in
  convert) convert_data ;;
  infer) infer "$@" ;;
  build-egodex) build_egodex ;;
  posttrain) posttrain "$@" ;;
  *) echo "Usage: $0 [--dry-run] {convert|infer|build-egodex|posttrain}" >&2; exit 2 ;;
esac

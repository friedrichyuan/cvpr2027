+        # AoE: initialize the action embedder's fc1 (input) layer. Upstream only zero-inits
+        # fc2 and never initializes fc1, so on meta-device `to_empty()` builds fc1 stays
+        # all-zero -- with fc1 at zero the embedder output does not depend on the action,
+        # so injected MANO actions cannot propagate through DreamDojo's conditioning path.
+        # Initialize fc1 (trunc_normal) so the action embedder is functional; keep fc2 as
+        # the intended zero-init warm-start (the adapter starts as a no-op and learns from
+        # there). The startup assert below guards against fc1 being left all-zero after
+        # init on any future build/refactor.
+        if hasattr(self, "action_embedder_B_D") and hasattr(self, "action_embedder_B_3D"):
+            for _emb in (self.action_embedder_B_D, self.action_embedder_B_3D):
+                nn.init.trunc_normal_(_emb.fc1.weight, std=0.02)
+                nn.init.zeros_(_emb.fc1.bias)
+                if self.zero_init_action_embedder:
+                    nn.init.zeros_(_emb.fc2.weight)
+                    nn.init.zeros_(_emb.fc2.bias)
+                else:
+                    nn.init.trunc_normal_(_emb.fc2.weight, std=0.02)
+                    nn.init.zeros_(_emb.fc2.bias)
+            # Startup guard: verify fc1 was initialized (not left all-zero) so the action
+            # embedder is functional on any future build/refactor.
+            assert not bool((self.action_embedder_B_D.fc1.weight == 0).all()), (
+                "action_embedder_B_D.fc1.weight is all-zero after init_weights() -- "
+                "the action embedder would not propagate the injected action."
+            )
+            assert not bool((self.action_embedder_B_3D.fc1.weight == 0).all()), (

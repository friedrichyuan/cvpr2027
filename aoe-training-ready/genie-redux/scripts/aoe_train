#!/usr/bin/env bash
# Open-AoE GenieRedux launcher: train the LAM / full generative Genie (tokenizer +
# LAM + dynamics) / guided-26D variant on AoE, inside an upstream GenieRedux checkout.
# Trainers run via torch.distributed.run; the upstream `models` package resolves through
# PYTHONPATH + GENIE_UPSTREAM_ROOT. Env-var driven (see README_OPEN_AOE.md); placeholders below
# are not real locations.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
INTEGRATION_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
UPSTREAM_ROOT="${GENIE_UPSTREAM_ROOT:-$INTEGRATION_ROOT}"

PY="${GENIE_PYTHON:-python}"
NPZ_DIR="${OPEN_AOE_NPZ_DIR:-/PATH_TO/aoe_npz/aoe26}"
OUT_DIR="${OUT_DIR:-/PATH_TO/aoe_runs/genie}"
NP="${NP:-3}"
GPUS="${CUDA_VISIBLE_DEVICES:-0,1,2}"
MASTER_PORT="${MASTER_PORT:-29577}"
MAX_CLIPS="${MAX_CLIPS:-10000}"
TRAIN_EPS="${TRAIN_EPS:-1100}"
LR="${LR:-1e-4}"
INFER_STEPS="${INFER_STEPS:-25}"
HOLDOUT_SKIP="${HOLDOUT_SKIP:-1100}"
ROLLOUT_CLIPS="${ROLLOUT_CLIPS:-64}"
SEED="${SEED:-0}"
TOK_EPOCHS="${TOK_EPOCHS:-40}";    TOK_BATCH="${TOK_BATCH:-8}"
GENIE_EPOCHS="${GENIE_EPOCHS:-22}"; GENIE_BATCH="${GENIE_BATCH:-4}"
GUIDED_EPOCHS="${GUIDED_EPOCHS:-22}"; GUIDED_BATCH="${GUIDED_BATCH:-6}"
LAM_EPOCHS="${LAM_EPOCHS:-6}";     LAM_BATCH="${LAM_BATCH:-2}"
TOK_CKPT="${TOK_CKPT:-$OUT_DIR/tokenizer.pt}"

export CUDA_VISIBLE_DEVICES="$GPUS"
export GENIE_UPSTREAM_ROOT="$UPSTREAM_ROOT"
export PYTHONPATH="$UPSTREAM_ROOT:$SCRIPT_DIR:${PYTHONPATH:-}"
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
# Tokenizer codebook-collapse fix: the upstream VQ (models/components/stvivit.py) needs EMA +
# dead-code revival, env-gated. Required for EVERY stage. Apply patches/open_aoe_support.patch
# to the upstream checkout first. See README_OPEN_AOE.md.
export AOE_VQ_EMA="${AOE_VQ_EMA:-1}"
export AOE_VQ_DEADCODE="${AOE_VQ_DEADCODE:-2}"

stream_flag=()
[[ -n "${STREAM:-}" ]] && stream_flag=(--stream)   # set STREAM=1 for the file-amortized streaming loader (100h+)

run_or_print() {
  if [[ "${DRY_RUN:-0}" == "1" ]]; then
    printf '[dry-run]'
    printf ' %q' "$@"
    printf '\n'
  else
    "$@"
  fi
}

# Multi-process (DDP) trainer launch, cwd = upstream root.
ddp_run() {
  local argv=("$PY" -m torch.distributed.run --nproc_per_node="$NP" --master-port "$MASTER_PORT" "$@")
  if [[ "${DRY_RUN:-0}" == "1" ]]; then run_or_print "${argv[@]}"; else ( cd "$UPSTREAM_ROOT" && "${argv[@]}" ); fi
}

# Single-process launch (rollout / plot / LAM), cwd = upstream root.
one_run() {
  local argv=("$PY" "$@")
  if [[ "${DRY_RUN:-0}" == "1" ]]; then run_or_print "${argv[@]}"; else ( cd "$UPSTREAM_ROOT" && "${argv[@]}" ); fi
}

downsample() {
  one_run "$SCRIPT_DIR/aoe_downsample.py" "$NPZ_DIR" "${DOWNSAMPLE_DST:-/PATH_TO/aoe_npz/aoe26_64}" "${RES:-64}" 0 1000000000
}

lam() {
  [[ "${DRY_RUN:-0}" == "1" ]] || mkdir -p "$OUT_DIR"
  one_run "$SCRIPT_DIR/genie_redux_lam.py" --npz-dir "$NPZ_DIR" --max-clips "$MAX_CLIPS" \
    --batch "$LAM_BATCH" --epochs "$LAM_EPOCHS" --lr "$LR" --out "$OUT_DIR/lam_loss.csv" "$@"
}

tokenizer() {
  ddp_run "$SCRIPT_DIR/genie_redux_full.py" --stage tokenizer --npz-dir "$NPZ_DIR" \
    --max-clips "$MAX_CLIPS" --train-eps "$TRAIN_EPS" --epochs "$TOK_EPOCHS" --batch "$TOK_BATCH" \
    --lr "$LR" --save-every 2000 --out-dir "$OUT_DIR" "${stream_flag[@]}" "$@"
}

genie() {
  ddp_run "$SCRIPT_DIR/genie_redux_full.py" --stage genie --tokenizer-ckpt "$TOK_CKPT" \
    --npz-dir "$NPZ_DIR" --max-clips "$MAX_CLIPS" --train-eps "$TRAIN_EPS" --epochs "$GENIE_EPOCHS" \
    --batch "$GENIE_BATCH" --lr "$LR" --save-every 2000 --out-dir "$OUT_DIR" "${stream_flag[@]}" "$@"
}

rollout() {
  one_run "$SCRIPT_DIR/genie_redux_full.py" --stage rollout --tokenizer-ckpt "$TOK_CKPT" \
    --model-ckpt "$OUT_DIR/genie.pt" --holdout-skip "$HOLDOUT_SKIP" --max-clips "$ROLLOUT_CLIPS" \
    --inference-steps "$INFER_STEPS" --n-gifs 8 --batch 8 --out-dir "$OUT_DIR" "$@"
}

plot_full() { one_run "$SCRIPT_DIR/plot_genie_full.py" "$OUT_DIR"; }

guided() {
  ddp_run "$SCRIPT_DIR/genie_redux_guided26d.py" --stage guided --tokenizer-ckpt "$TOK_CKPT" \
    --npz-dir "$NPZ_DIR" --max-clips "$MAX_CLIPS" --train-eps "$TRAIN_EPS" --epochs "$GUIDED_EPOCHS" \
    --batch "$GUIDED_BATCH" --lr "$LR" --save-every 2000 --seed "$SEED" --out-dir "$OUT_DIR/guided" "${stream_flag[@]}" "$@"
}

guided_rollout() {
  one_run "$SCRIPT_DIR/genie_redux_guided26d.py" --stage rollout --tokenizer-ckpt "$TOK_CKPT" \
    --model-ckpt "$OUT_DIR/guided/guided.pt" --holdout-skip "$HOLDOUT_SKIP" --max-clips "$ROLLOUT_CLIPS" \
    --inference-steps "$INFER_STEPS" --n-gifs 8 --batch 8 --seed "$SEED" --out-dir "$OUT_DIR/guided" "$@"
}

plot_guided() { one_run "$SCRIPT_DIR/plot_guided.py" "$OUT_DIR/guided"; }

# Go/no-go: codebook utilization of the tokenizer (want >= 111 used codes before genie).
gate() { one_run "$SCRIPT_DIR/aoe_codebook_util.py" "$TOK_CKPT"; }

cmd="${1:-full}"
shift || true
if [[ "$cmd" == "--dry-run" ]]; then
  DRY_RUN=1
  cmd="${1:-full}"
  shift || true
fi

case "$cmd" in
  downsample) downsample ;;
  lam) lam "$@" ;;
  tokenizer) tokenizer "$@" ;;
  genie) genie "$@" ;;
  rollout) rollout "$@" ;;
  full) tokenizer; genie; rollout; plot_full ;;
  guided) guided "$@" ;;
  guided-rollout) guided_rollout "$@" ;;
  guided-all) guided; guided_rollout; plot_guided ;;
  gate) gate ;;
  *) echo "Usage: $0 [--dry-run] {downsample|lam|tokenizer|genie|rollout|full|guided|guided-rollout|guided-all|gate}" >&2; exit 2 ;;
esac

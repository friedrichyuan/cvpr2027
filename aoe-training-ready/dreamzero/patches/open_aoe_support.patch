+def _finite_debug_enabled() -> bool:
+    return os.getenv("DREAMZERO_DEBUG_FINITE", "0").lower() in {"1", "true", "yes"}
+
+
+def _finite_debug_rank0() -> bool:
+    return (not dist.is_available()) or (not dist.is_initialized()) or dist.get_rank() == 0
+
+
+def _finite_debug_tensor(name: str, tensor: torch.Tensor | None, step: int | None = None) -> None:
+    if not _finite_debug_enabled() or not _finite_debug_rank0():
+        return
+    if tensor is None:
+        print(f"[FINITE_DEBUG] step={step} {name}: None")
+        return
+    with torch.no_grad():
+        detached = tensor.detach()
+        finite = torch.isfinite(detached)
+        finite_count = int(finite.sum().item())
+        total = detached.numel()
+        nan_count = int(torch.isnan(detached).sum().item()) if torch.is_floating_point(detached) else 0
+        inf_count = int(torch.isinf(detached).sum().item()) if torch.is_floating_point(detached) else 0
+        if finite_count:
+            finite_values = detached[finite].float()
+            min_value = float(finite_values.min().item())
+            max_value = float(finite_values.max().item())
+            mean_value = float(finite_values.mean().item())
+        else:
+            min_value = max_value = mean_value = float("nan")
+        print(
+            f"[FINITE_DEBUG] step={step} {name}: shape={tuple(detached.shape)} "
+            f"dtype={detached.dtype} finite={finite_count}/{total} nan={nan_count} inf={inf_count} "
+            f"min={min_value:.6g} max={max_value:.6g} mean={mean_value:.6g}"
+        )
+
+

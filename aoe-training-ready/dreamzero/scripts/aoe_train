#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
INTEGRATION_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
UPSTREAM_ROOT="${DREAMZERO_UPSTREAM_ROOT:-$INTEGRATION_ROOT}"

CONDA_BIN="${CONDA_BIN:-conda}"
CONDA_ENV="${CONDA_ENV:-wam_dreamzero}"
RAW_ROOT="${OPEN_AOE_RAW_ROOT:-/PATH_TO/general_datasets/Open-AoE/poc_deliver}"
DATA_ROOT="${OPEN_AOE_WAM_ROOT:-/PATH_TO/dataset/Open_AoE/open_aoe_mano_nextstate_224_110d_wam_v2}"
CKPT_ROOT="${CKPT_ROOT:-/PATH_TO/ckpts/HF_ckpts}"
RESULTS_DIR="${AOE_RESULTS_DIR:-/PATH_TO/aoe_runs/wam_dreamzero_open_aoe}"
GPUS="${CUDA_VISIBLE_DEVICES:-0,1,2,3,4,5,6,7}"
NGPU="${NGPU:-8}"
STEPS="${STEPS:-100000}"
SAVE_STEPS="${SAVE_STEPS:-$STEPS}"
BATCH_SIZE="${BATCH_SIZE:-1}"

export CUDA_VISIBLE_DEVICES="$GPUS"
export DREAMZERO_ROOT="$UPSTREAM_ROOT"
export HF_HOME="${HF_HOME:-$CKPT_ROOT/.cache/huggingface}"
export HYDRA_FULL_ERROR="${HYDRA_FULL_ERROR:-1}"
export WANDB_MODE="${WANDB_MODE:-offline}"
export PYTHONPATH="$UPSTREAM_ROOT:$INTEGRATION_ROOT:${PYTHONPATH:-}"

run_or_print() {
  if [[ "${DRY_RUN:-0}" == "1" ]]; then
    printf '[dry-run]'
    printf ' %q' "$@"
    printf '\n'
  else
    "$@"
  fi
}

convert_data() {
  run_or_print "$CONDA_BIN" run -n "$CONDA_ENV" python "$INTEGRATION_ROOT/scripts/convert_open_aoe_to_wam_v2.py" \
    --input-root "$RAW_ROOT" \
    --output-root "$DATA_ROOT" \
    --limit "${CONVERT_LIMIT:-16}" \
    --max-frames-per-episode "${MAX_FRAMES_PER_EPISODE:-360}" \
    --overwrite
}

prepare_gear_metadata() {
  run_or_print "$CONDA_BIN" run -n "$CONDA_ENV" python "$UPSTREAM_ROOT/scripts/data/convert_lerobot_to_gear.py" \
    --dataset-path "$DATA_ROOT" \
    --embodiment-tag open_aoe \
    --state-keys '{"hand_state":[0,110]}' \
    --action-keys '{"hand_target":[0,110]}' \
    --task-key task \
    --fps 30 \
    --action-horizon 24 \
    --force
}

train_model() {
  cd "$UPSTREAM_ROOT"
  local argv=(
    "$CONDA_BIN" run --no-capture-output -n "$CONDA_ENV" python -m torch.distributed.run
    --nproc_per_node "$NGPU" \
    --standalone \
    groot/vla/experiment/experiment.py \
    report_to=none \
    data=dreamzero/open_aoe_relative_wan22 \
    wandb_project=dreamzero \
    train_architecture=lora \
    num_frames=33 \
    action_horizon=24 \
    num_views=1 \
    max_state_dim=110 \
    max_action_dim=110 \
    model=dreamzero/vla \
    model/dreamzero/action_head=wan_flow_matching_action_tf_wan22 \
    model/dreamzero/transform=dreamzero_cotrain \
    num_frame_per_block=2 \
    num_action_per_block=24 \
    num_state_per_block=1 \
    seed=42 \
    training_args.learning_rate="${LR:-1e-5}" \
    training_args.deepspeed=groot/vla/configs/deepspeed/zero2.json \
    save_steps="$SAVE_STEPS" \
    training_args.warmup_ratio="${WARMUP_RATIO:-0.05}" \
    output_dir="$RESULTS_DIR/dreamzero_train" \
    per_device_train_batch_size="$BATCH_SIZE" \
    max_steps="$STEPS" \
    weight_decay=1e-5 \
    save_total_limit="${SAVE_TOTAL_LIMIT:-5}" \
    upload_checkpoints=false \
    bf16=true \
    tf32=true \
    eval_bf16=true \
    dataloader_pin_memory=false \
    dataloader_num_workers="${NUM_WORKERS:-1}" \
    image_resolution_width=224 \
    image_resolution_height=224 \
    save_lora_only=true \
    max_chunk_size=4 \
    frame_seqlen=49 \
    save_strategy=steps \
    open_aoe_data_root="$DATA_ROOT" \
    dit_version="$CKPT_ROOT/Wan-AI/Wan2.2-TI2V-5B" \
    text_encoder_pretrained_path="$CKPT_ROOT/Wan-AI/Wan2.2-TI2V-5B/models_t5_umt5-xxl-enc-bf16.pth" \
    image_encoder_pretrained_path="$CKPT_ROOT/Wan-AI/Wan2.1-I2V-14B-480P/models_clip_open-clip-xlm-roberta-large-vit-huge-14.pth" \
    vae_pretrained_path="$CKPT_ROOT/Wan-AI/Wan2.2-TI2V-5B/Wan2.2_VAE.pth" \
    tokenizer_path="$CKPT_ROOT/google/umt5-xxl"
  )
  argv+=("$@")
  if [[ "${DRY_RUN:-0}" == "1" ]]; then
    run_or_print "${argv[@]}"
  else
    mkdir -p "$RESULTS_DIR/logs" "$RESULTS_DIR/dreamzero_train"
    "${argv[@]}" 2>&1 | tee "$RESULTS_DIR/logs/train.log"
  fi
}

plot_curves() {
  run_or_print "$CONDA_BIN" run -n "$CONDA_ENV" python "$INTEGRATION_ROOT/scripts/plot_loss_curves.py" \
    --input "$RESULTS_DIR/dreamzero_train/loss_log.jsonl" \
    --output-dir "$RESULTS_DIR/curves/dreamzero" \
    --name dreamzero
}

cmd="${1:-train}"
shift || true
if [[ "$cmd" == "--dry-run" ]]; then
  DRY_RUN=1
  cmd="${1:-train}"
  shift || true
fi

case "$cmd" in
  convert) convert_data ;;
  gear) prepare_gear_metadata ;;
  train) prepare_gear_metadata; train_model "$@"; plot_curves ;;
  train-only) train_model "$@"; plot_curves ;;
  curves) plot_curves ;;
  *) echo "Usage: $0 [--dry-run] {convert|gear|train|train-only|curves}" >&2; exit 2 ;;
esac

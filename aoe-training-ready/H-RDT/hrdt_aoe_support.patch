+#!/usr/bin/env python3
+"""
+AoE dataset loader
+Implements 48-dimensional hand action representation, single-view images and language embedding data loading
+
+This follows datasets/pretrain/egodex_dataset.py's Dataset interface, while
+preloading AoE video frames for faster training.
+"""
+
+import os
+import json
+import random
+import hashlib
+import warnings
+from multiprocessing import Pool
+
+import cv2
+import h5py
+import numpy as np
+import torch
+from pathlib import Path
+
+warnings.filterwarnings("ignore")
+
+
+# --------------------------------------------------------------------------- #
+# Top-level worker (must be picklable for multiprocessing).
+# --------------------------------------------------------------------------- #
+def _decode_segment_to_jpeg(args):
+    """Decode the available frame range of one segment to JPEGs. Runs in worker.
+
+    Returns ``(status, mp4_path, got, expected)``. ``status`` is one of:
+    ``cached`` (already complete), ``built`` (decoded ok; includes videos that are
+    legitimately shorter than ``seg_len``), or a ``failed_*`` code for genuine
+    problems (cannot open, zero usable frames, decode stops early, or write fails).
+    """
+    mp4_path, cache_dir, start_frame, seg_len, quality, force_rebuild = args
+    cache_dir = Path(cache_dir)
+    cache_dir.mkdir(parents=True, exist_ok=True)
+
+    cap = cv2.VideoCapture(str(mp4_path))
+    if not cap.isOpened():
+        print(f"[AoE] failed to open {mp4_path}")
+        return ("failed_open", mp4_path, 0, seg_len)
+
+    try:
+        total = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))
+        seg_duration = max(0, min(seg_len, total - start_frame))
+        if seg_duration <= 0:
+            # start_frame is past the end of the video: the segment has no usable
+            # frames at all, which is a real data mismatch rather than "a bit short".
+            print("eg duration < 0")
+            return ("failed_empty", mp4_path, 0, seg_len)
+
+        # Completeness is judged against the real available last frame, not
+        # seg_len, so videos shorter than the HDF5 action length are not rebuilt
+        # on every run.
+        last_jpg = cache_dir / f"{start_frame + seg_duration - 1:08d}.jpg"
+        if last_jpg.exists() and not force_rebuild:
+            return ("cached", mp4_path, seg_duration, seg_len)
+
+        cap.set(cv2.CAP_PROP_POS_FRAMES, start_frame)
+        n_decoded = 0
+        for i in range(seg_duration):
+            ret, frame = cap.read()
+            if not ret:
+                print(f"[partial] {Path(mp4_path).name} "
+                      f"n_decoded={n_decoded} seg_duration={seg_duration} "
+                      f"total={total} start_frame={start_frame} seg_len={seg_len}")
+                return ("failed_partial", mp4_path, n_decoded, seg_duration)
+            out = cache_dir / f"{start_frame + i:08d}.jpg"
+            if not cv2.imwrite(str(out), frame, [int(cv2.IMWRITE_JPEG_QUALITY), quality]):
+                print("failed write")
+                return ("failed_write", mp4_path, n_decoded, seg_duration)
+            n_decoded += 1
+    finally:
+        cap.release()
+    return ("built", mp4_path, n_decoded, seg_len)
+
+
+class AoEDataset:
+    """AoE dataset loader"""
+
+    DATASET_NAME = "aoe"
+
+    def __init__(
+        self,
+        data_root=None,
+        config=None,
+        upsample_rate=3,
+        val=False,
+        use_precomp_lang_embed=True,
+        stat_path=None,
+        frame_cache_root=None,
+        num_workers=8,
+        jpeg_quality=95,
+        force_rebuild=False,
+    ):
+        """
+        Args:
+            data_root: processed data root (train/ test/ subdirs)
+            config: YAML config dict
+            upsample_rate: temporal stride for action chunking
+            val: True for test split
+            use_precomp_lang_embed: use .pt language embeddings
+            stat_path: path to aoe_stat.json
+            frame_cache_root: where to put decoded JPEGs (default: data_root/_frame_cache)
+            num_workers: processes used to build the frame cache
+            jpeg_quality: JPEG quality for the frame cache
+            force_rebuild: ignore existing image cache and rebuild
+        """
+        self.data_root = Path(data_root)
+        self.config = config
+        self.upsample_rate = upsample_rate
+        self.val = val
+        self.use_precomp_lang_embed = use_precomp_lang_embed
+
+        if config:
+            self.chunk_size = config['common']['action_chunk_size']
+            self.state_dim = config['common']['action_dim']
+            self.img_history_size = config['common']['img_history_size']
+        else:
+            self.chunk_size = 16
+            self.state_dim = 48
+            self.img_history_size = 1
+        self.action_dim = self.state_dim
+
+        # Normalization stats (precompute denom once).
+        if stat_path is None:
+            stat_path = self.data_root / 'aoe_stat.json'
+        self.action_min = None
+        self.action_max = None
+        self.action_denom = None
+        if os.path.exists(stat_path):
+            with open(stat_path, 'r') as f:
+                stat = json.load(f)
+            if 'aoe' in stat:
+                self.action_min = np.array(stat['aoe']['min'], dtype=np.float32)
+                self.action_max = np.array(stat['aoe']['max'], dtype=np.float32)
+                denom = self.action_max - self.action_min
+                self.action_denom = np.where(denom < 1e-8, 1.0, denom).astype(np.float32)
+
+        # Load data file list
+        self.data_files = self._load_file_list()
+        split_name = "test" if self.val else "train"
+        print(f"Loaded {len(self.data_files)} {split_name} AoE data files")
+
+        # --- Frame JPEG cache.
+        self.frame_cache_root = Path(frame_cache_root) if frame_cache_root \
+            else self.data_root / '_frame_cache'
+        if self.data_files:
+            self._build_frame_cache(num_workers=num_workers,
+                                    jpeg_quality=jpeg_quality,
+                                    force_rebuild=force_rebuild)
+
+    # ------------------------------------------------------------------ #
+    # File list
+    # ------------------------------------------------------------------ #
+    def get_dataset_name(self):
+        """Return dataset name"""
+        return self.DATASET_NAME
+
+    def _load_file_list(self):
+        """Load data file list"""
+        files = []
+        if not self.data_root.exists():
+            return []
+        for episode_dir in sorted(self.data_root.iterdir()):
+            if not episode_dir.is_dir() or episode_dir.name.startswith('_'):
+                continue
+            for hdf5_file in sorted(episode_dir.glob('*.hdf5')):
+                idx = hdf5_file.stem
+                mp4_file = episode_dir / f"{idx}.mp4"
+                pt_file = episode_dir / f"{idx}.pt"
+                meta_file = episode_dir / f"{idx}.meta.json"
+                if not mp4_file.exists():
+                    continue
+                if self.use_precomp_lang_embed and not pt_file.exists():
+                    continue
+                files.append({
+                    'hdf5': hdf5_file, 'mp4': mp4_file, 'pt': pt_file,
+                    'meta': meta_file, 'task': episode_dir.name, 'file_index': idx,
+                })
+        return files
+
+    def __len__(self):
+        return len(self.data_files)
+
+    # ------------------------------------------------------------------ #
+    # Frame JPEG cache
+    # ------------------------------------------------------------------ #
+    def _video_id(self, mp4_path):
+        try:
+            rp = str(Path(mp4_path).resolve())
+        except Exception:
+            rp = str(mp4_path)
+        return hashlib.md5(rp.encode()).hexdigest()[:16]
+
+    def _resolve_cache_dir(self, mp4_path):
+        return str(self.frame_cache_root / self._video_id(mp4_path))
+
+    @staticmethod
+    def _read_start_frame(meta_path):
+        if not meta_path.exists():
+            return 0
+        try:
+            with open(meta_path, 'r') as f:
+                return json.load(f).get('start_frame', 0)
+        except Exception:
+            return 0
+
+    def _build_frame_cache(self, num_workers=8, jpeg_quality=95, force_rebuild=False):
+        jobs = []
+        for d in self.data_files:
+            with h5py.File(d['hdf5'], 'r') as f:
+                seg_len = int(f['actions'].shape[0])
+            start_frame = int(self._read_start_frame(d['meta']))
+            cache_dir = self._resolve_cache_dir(d['mp4'])
+            jobs.append((str(d['mp4']), cache_dir, int(start_frame),
+                         seg_len, jpeg_quality, force_rebuild))
+
+        # Pre-filter: skip segments that are already fully cached so the progress
+        # message is accurate and we don't spin up workers for nothing. The cheap
+        # check (seg_len-based last frame) catches full-length videos without
+        # opening anything; only the remainder pay for a metadata probe to find
+        # their real available last frame (handles videos shorter than seg_len).
+        todo = []
+        for job in jobs:
+            (mp4, cache_dir, start_frame, seg_len, q, rebuild) = job
+            if not rebuild:
+                if (Path(cache_dir) / f"{start_frame + seg_len - 1:08d}.jpg").exists():
+                    continue
+                # Video may be shorter than seg_len: probe its real frame count
+                # (metadata only, no decode) and check the real available last frame.
+                cap = cv2.VideoCapture(mp4)
+                total = int(cap.get(cv2.CAP_PROP_FRAME_COUNT)) if cap.isOpened() else 0
+                cap.release()
+                avail = max(0, min(seg_len, total - start_frame))
+                if avail and (Path(cache_dir) / f"{start_frame + avail - 1:08d}.jpg").exists():
+                    continue
+            todo.append(job)
+
+        if not todo:
+            print(f"[AoE] frame cache up to date ({len(jobs)} segments)")
+            return
+        print(f"[AoE] building JPEG frame cache for {len(todo)}/{len(jobs)} "
+              f"segments with {num_workers} workers ...")
+
+        results = []
+        if num_workers <= 1:
+            for j in todo:
+                results.append(_decode_segment_to_jpeg(j))
+        else:
+            with Pool(num_workers) as pool:
+                for r in pool.imap_unordered(_decode_segment_to_jpeg, todo):
+                    results.append(r)
+
+        built = sum(1 for r in results if r[0] == "built")
+        cached = sum(1 for r in results if r[0] == "cached")
+        failures = [r for r in results if r[0].startswith("failed")]
+        already = len(jobs) - len(todo)
+        print(f"[AoE] frame cache ready: {already + cached} cached, "
+              f"{built} built, {len(failures)} failed")
+        if failures:
+            for status, mp4, got, exp in failures[:10]:
+                print(f"  [AoE] {status}: {mp4} (got {got}/{exp})")
+            if len(failures) > 10:
+                print(f"  [AoE] ... and {len(failures) - 10} more")
+            raise RuntimeError(
+                f"[AoE] frame cache build failed for {len(failures)}/{len(todo)} "
+                f"segments; see the list above.")
+
+    def construct_48d_action(self, hdf5_file, frame_indices):
+        """
+        Directly extract precomputed 48-dimensional hand action representation.
+
+        Args:
+            hdf5_file: HDF5 file object
+            frame_indices: List of frame indices to extract
+
+        Returns:
+            actions: (T, 48) action sequence
+        """
+        if 'actions' not in hdf5_file:
+            raise ValueError("Missing precomputed actions data in HDF5 file")
+
+        precomputed_actions = hdf5_file['actions'][:]
+        selected_actions = precomputed_actions[frame_indices]
+
+        return selected_actions.astype(np.float32)
+
+    def parse_img_data(self, mp4_path, idx):
+        """
+        Load image frames following EgoDexDataset sampling logic.
+
+        Args:
+            mp4_path: MP4 file path
+            idx: Current absolute frame index
+
+        Returns:
+            frames: (img_history_size, H, W, 3) image frames
+        """
+        start_i = max(idx - self.img_history_size * self.upsample_rate + 1, 0)
+        cache_dir = Path(self._resolve_cache_dir(mp4_path))
+        frames = []
+
+        for fi in range(start_i, idx + 1, self.upsample_rate):
+            jpg = cache_dir / f"{fi:08d}.jpg"
+            frame = None
+            if jpg.exists():
+                img = cv2.imread(str(jpg), cv2.IMREAD_COLOR)
+                if img is not None:
+                    frame = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
+            if frame is None:
+                # Fallback: decode this single frame from the video directly.
+                frame = self._decode_one_frame(mp4_path, fi)
+            if frame is not None:
+                frames.append(frame)
+
+        if not frames:
+            frames = [np.zeros((720, 1280, 3), dtype=np.uint8)]
+        frames = np.array(frames)
+
+        if frames.shape[0] < self.img_history_size:
+            pad = np.repeat(frames[:1], self.img_history_size - frames.shape[0], axis=0)
+            frames = np.concatenate([pad, frames], axis=0)
+        return frames
+
+    def _load_frames(self, mp4_path, frame_idx):
+        """Backward-compatible alias for the old AoEDataset helper."""
+        return self.parse_img_data(mp4_path, frame_idx)[-self.img_history_size:]
+
+    @staticmethod
+    def _decode_one_frame(mp4_path, frame_idx):
+        cap = cv2.VideoCapture(str(mp4_path))
+        if not cap.isOpened():
+            return None
+        try:
+            cap.set(cv2.CAP_PROP_POS_FRAMES, frame_idx)
+            ret, frame = cap.read()
+            if ret:
+                return cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
+        finally:
+            cap.release()
+        return None
+
+    # ------------------------------------------------------------------ #
+    # get_item / __getitem__
+    # ------------------------------------------------------------------ #
+    def get_item(self, idx=None):
+        """
+        Get a data sample
+
+        Returns:
+            Data dictionary containing all required fields
+        """
+        if idx is None:
+            idx = random.randint(0, len(self.data_files) - 1)
+        segment_idx = idx % len(self.data_files)
+        file_info = self.data_files[segment_idx]
+
+        try:
+            # Load meta for video frame range
+            start_frame = int(self._read_start_frame(file_info['meta']))
+
+            # Load HDF5 data
+            with h5py.File(file_info['hdf5'], 'r') as f:
+                total_seg_frames = f['actions'].shape[0]
+                max_index = total_seg_frames - 2
+                if max_index < 0:
+                    print(f"Warning: Not enough frames in {file_info['hdf5']}")
+                    return None
+
+                # Random index for sampling
+                index = random.randint(0, max_index)
+
+                # Construct 48-dimensional actions using current index
+                current_action = self.construct_48d_action(f, [index])
+
+                # Future action sequence
+                action_end = min(index + self.chunk_size * self.upsample_rate, max_index + 1)
+                action_indices = list(range(index + 1, action_end + 1, self.upsample_rate))
+
+                # If not enough action frames, repeat the last one
+                while len(action_indices) < self.chunk_size:
+                    action_indices.append(
+                        action_indices[-1] if action_indices
+                        else min(index + 1, total_seg_frames - 1))
+
+                # Extract action sequence
+                actions = self.construct_48d_action(f, action_indices[:self.chunk_size])
+
+                if actions.shape[0] < self.chunk_size:
+                    pad = np.repeat(actions[-1:],
+                                    self.chunk_size - actions.shape[0], axis=0)
+                    actions = np.concatenate([actions, pad], axis=0)
+
+            # Normalize (denom precomputed once).
+            if self.action_min is not None:
+                current_action = np.clip(
+                    (current_action - self.action_min) / self.action_denom * 2 - 1,
+                    -1, 1)
+                actions = np.clip(
+                    (actions - self.action_min) / self.action_denom * 2 - 1,
+                    -1, 1)
+
+            # Load single-view image frames using EgoDexDataset sampling logic
+            video_frame_idx = start_frame + index
+            image_frames = self.parse_img_data(file_info['mp4'], video_frame_idx)
+
+            # Take only the required history size
+            image_frames = image_frames[-self.img_history_size:]
+
+            # Load language embedding
+            lang_embed_path = file_info['pt']
+
+            return {
+                'states': current_action.astype(np.float32),  # (1, 48)
+                'actions': actions.astype(np.float32),  # (chunk_size, 48)
+                'action_norm': np.ones_like(actions, dtype=np.float32),  # Action indicator
+                'current_images': [image_frames],  # [(img_history_size, H, W, 3)] single view
+                'current_images_mask': [np.ones(self.img_history_size, dtype=bool)],  # Image mask
+                'instruction': str(lang_embed_path),  # Language embedding file path
+                'dataset_name': self.DATASET_NAME,
+                'task': file_info['task'],
+                'file_info': {
+                    'hdf5_path': str(file_info['hdf5']),
+                    'mp4_path': str(file_info['mp4']),
+                    'pt_path': str(file_info['pt']),
+                    'total_frames': total_seg_frames,
+                    'selected_index': index,
+                    'action_indices': action_indices,
+                }
+            }
+        except Exception as e:
+            print(f"Error loading data {file_info['hdf5']}: {e}")
+            return None
+
+    def __getitem__(self, idx):
+        """PyTorch Dataset interface"""
+        return self.get_item(idx)
+
+
+if __name__ == "__main__":
+    root = "/root/datasets/AoE_processed_data"
+    dataset = AoEDataset(
+        data_root=root, val=False, upsample_rate=3,
+        num_workers=16,
+    )
+    print(f"Dataset size: {len(dataset)}")
+    if len(dataset) > 0:
+        import time
+        sample = dataset.get_item(20)
+        if sample:
+            for k, v in sample.items():
+                if isinstance(v, np.ndarray):
+                    print(f"  {k}: shape={v.shape}, dtype={v.dtype}")
+                else:
+                    print(f"  {k}: {type(v).__name__}")
+        # Quick timing.
+        t0 = time.time()
+        for _ in range(50):
+            dataset.get_item()
+        print(f"avg get_item: {(time.time() - t0) / 50 * 1000:.1f} ms")

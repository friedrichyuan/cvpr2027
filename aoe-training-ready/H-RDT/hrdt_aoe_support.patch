index 0000000..7e4139e
--- /dev/null
+++ b/datasets/aoe_dataset.py
@@ -0,0 +1,251 @@
+#!/usr/bin/env python3
+"""
+AoE dataset loader for H-RDT training.
+
+Loads precomputed per-segment HDF5 files produced by precompute_actions.py.
+Each segment has:
+  - <idx>.hdf5: actions + validity
+  - <idx>.mp4: symlink to undistorted video
+  - <idx>.pt: T5 language embeddings
+  - <idx>.meta.json: frame range for video seeking
+
+Supports the same interface as EgoDexDataset for drop-in use with VLAConsumerDataset.
+"""
+
+import os
+import json
+import random
+import warnings
+
+import cv2
+import h5py
+import numpy as np
+import torch
+from pathlib import Path
+
+warnings.filterwarnings("ignore")
+
+
+class AoEDataset:
+    """AoE (Art of Embodiment) dataset — segmented human manipulation data with MANO."""
+
+    DATASET_NAME = "aoe"
+
+    def __init__(
+        self,
+        data_root=None,
+        config=None,
+        upsample_rate=3,
+        val=False,
+        use_precomp_lang_embed=True,
+        stat_path=None,
+    ):
+        """
+        Args:
+            data_root: Processed data root (contains train/ and test/ subdirs)
+            config: YAML config dict
+            upsample_rate: temporal downsampling factor for action chunking
+            val: True for test split, False for train
+            use_precomp_lang_embed: whether to use .pt embeddings
+            stat_path: path to aoe_stat.json for normalization
+        """
+        self.data_root = Path(data_root)
+        self.config = config
+        self.upsample_rate = upsample_rate
+        self.val = val
+        self.use_precomp_lang_embed = use_precomp_lang_embed
+
+        if config:
+            self.chunk_size = config['common']['action_chunk_size']
+            self.action_dim = config['common']['action_dim']
+            self.img_history_size = config['common']['img_history_size']
+        else:
+            self.chunk_size = 16
+            self.action_dim = 48
+            self.img_history_size = 1
+
+        # Load normalization stats
+        if stat_path is None:
+            stat_path = self.data_root / 'aoe_stat.json'
+        self.action_min = None
+        self.action_max = None
+        if os.path.exists(stat_path):
+            with open(stat_path, 'r') as f:
+                stat = json.load(f)
+            if 'aoe' in stat:
+                self.action_min = np.array(stat['aoe']['min'], dtype=np.float32)
+                self.action_max = np.array(stat['aoe']['max'], dtype=np.float32)
+
+        # Load file list
+        self.data_files = self._load_file_list()
+        print(f"[AoE] Loaded {len(self.data_files)} segments")
+
+    def get_dataset_name(self):
+        return self.DATASET_NAME
+
+    def _load_file_list(self):
+        """Scan for (hdf5, mp4, pt, meta) tuples."""
+        files = []
+        if not self.data_root.exists():
+            return []
+
+        for episode_dir in sorted(self.data_root.iterdir()):
+            if not episode_dir.is_dir():
+                continue
+            for hdf5_file in sorted(episode_dir.glob('*.hdf5')):
+                idx = hdf5_file.stem
+                mp4_file = episode_dir / f"{idx}.mp4"
+                pt_file = episode_dir / f"{idx}.pt"
+                meta_file = episode_dir / f"{idx}.meta.json"
+
+                if not mp4_file.exists():
+                    continue
+                if self.use_precomp_lang_embed and not pt_file.exists():
+                    continue
+
+                files.append({
+                    'hdf5': hdf5_file,
+                    'mp4': mp4_file,
+                    'pt': pt_file,
+                    'meta': meta_file,
+                    'task': episode_dir.name,
+                    'file_index': idx,
+                })
+        return files
+
+    def __len__(self):
+        return len(self.data_files)
+
+    def get_item(self, idx=None):
+        """Get one training sample (compatible with VLAConsumerDataset interface)."""
+        if idx is None:
+            idx = random.randint(0, len(self.data_files) - 1)
+
+        file_info = self.data_files[idx % len(self.data_files)]
+
+        try:
+            # Load meta for video frame range
+            meta = {}
+            if file_info['meta'].exists():
+                with open(file_info['meta'], 'r') as f:
+                    meta = json.load(f)
+            start_frame = meta.get('start_frame', 0)
+
+            # Load HDF5
+            with h5py.File(file_info['hdf5'], 'r') as f:
+                actions_all = f['actions'][:]  # (T_seg, action_dim)
+
+            total_seg_frames = actions_all.shape[0]
+            max_index = total_seg_frames - 2
+            if max_index < 0:
+                return None
+
+            # Random sample point within segment
+            index = random.randint(0, max_index)
+
+            # Current state
+            current_action = actions_all[index:index+1]  # (1, D)
+
+            # Future action chunk
+            action_end = min(index + self.chunk_size * self.upsample_rate, total_seg_frames)
+            action_indices = list(range(index + 1, action_end, self.upsample_rate))
+
+            while len(action_indices) < self.chunk_size:
+                action_indices.append(action_indices[-1] if action_indices else min(index + 1, total_seg_frames - 1))
+
+            action_indices = action_indices[:self.chunk_size]
+            actions = actions_all[action_indices]
+
+            if actions.shape[0] < self.chunk_size:
+                pad = np.repeat(actions[-1:], self.chunk_size - actions.shape[0], axis=0)
+                actions = np.concatenate([actions, pad], axis=0)
+
+            # Normalize
+            if self.action_min is not None:
+                denom = self.action_max - self.action_min
+                denom = np.where(denom < 1e-8, 1.0, denom)
+                current_action = np.clip((current_action - self.action_min) / denom * 2 - 1, -1, 1)
+                actions = np.clip((actions - self.action_min) / denom * 2 - 1, -1, 1)
+
+            # Load video frame (offset by segment start_frame in the full video)
+            video_frame_idx = start_frame + index
+            image_frames = self._load_frames(file_info['mp4'], video_frame_idx)
+
+            # Language embedding
+            lang_embed_path = str(file_info['pt'])
+
+            return {
+                'states': current_action.astype(np.float32),
+                'actions': actions.astype(np.float32),
+                'action_norm': np.ones_like(actions, dtype=np.float32),
+                'current_images': [image_frames],
+                'current_images_mask': [np.ones(self.img_history_size, dtype=bool)],
+                'instruction': lang_embed_path,
+                'dataset_name': self.DATASET_NAME,
+                'task': file_info['task'],
+                'file_info': {
+                    'hdf5_path': str(file_info['hdf5']),
+                    'mp4_path': str(file_info['mp4']),
+                    'pt_path': str(file_info['pt']),
+                    'total_frames': total_seg_frames,
+                    'selected_index': index,
+                    'action_indices': action_indices,
+                }
+            }
+
+        except Exception as e:
+            print(f"[AoE] Error loading {file_info['hdf5']}: {e}")
+            return None
+
+    def _load_frames(self, mp4_path, frame_idx):
+        """Load image frames from video at the given absolute frame index."""
+        cap = cv2.VideoCapture(str(mp4_path))
+        total_video_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))
+
+        start_i = max(frame_idx - self.img_history_size * self.upsample_rate + 1, 0)
+        frames = []
+
+        try:
+            for fi in range(start_i, frame_idx + 1, self.upsample_rate):
+                if fi >= total_video_frames:
+                    break
+                cap.set(cv2.CAP_PROP_POS_FRAMES, fi)
+                ret, frame = cap.read()
+                if ret:
+                    frames.append(cv2.cvtColor(frame, cv2.COLOR_BGR2RGB))
+                else:
+                    break
+        finally:
+            cap.release()
+
+        if not frames:
+            frames = [np.zeros((720, 1280, 3), dtype=np.uint8)]
+
+        frames = np.array(frames)
+
+        # Pad to img_history_size
+        if frames.shape[0] < self.img_history_size:
+            pad = np.repeat(frames[:1], self.img_history_size - frames.shape[0], axis=0)
+            frames = np.concatenate([pad, frames], axis=0)
+
+        return frames[-self.img_history_size:]
+
+    def __getitem__(self, idx):
+        return self.get_item(idx)
+
+
+if __name__ == "__main__":
+    dataset = AoEDataset(
+        data_root="/path/to/H_RDT/processed_data",
+        val=False,
+        upsample_rate=3,
+    )
+    print(f"Dataset size: {len(dataset)}")
+    if len(dataset) > 0:
+        sample = dataset.get_item(0)
+        if sample:
+            for k, v in sample.items():
+                if isinstance(v, np.ndarray):
+                    print(f"  {k}: shape={v.shape}, dtype={v.dtype}")
+                else:
+                    print(f"  {k}: {type(v).__name__}")

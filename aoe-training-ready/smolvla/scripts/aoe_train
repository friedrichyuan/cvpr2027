#!/usr/bin/env bash
# Open-AoE SmolVLA launcher: convert AoE data to a LeRobot dataset, fine-tune
# SmolVLA, run offline held-out eval, and plot loss curves. All paths are env-var
# driven (see README.md); the placeholders below are not real locations.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
INTEGRATION_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

PYTHON_BIN="${SMOLVLA_PYTHON:-python}"
RAW_ROOT="${OPEN_AOE_RAW_ROOT:-/PATH_TO/Open-AoE/poc_deliver}"
NPZ_DIR="${OPEN_AOE_NPZ_DIR:-/PATH_TO/aoe_npz/aoe26}"
DATA_ROOT="${OPEN_AOE_LEROBOT_ROOT:-/PATH_TO/lerobot_aoe/aoe26}"
REPO_ID="${OPEN_AOE_REPO_ID:-aoe26}"
DIM="${DIM:-26}"
MAX_FRAMES="${MAX_FRAMES:-64}"
SMOLVLA_BASE="${SMOLVLA_BASE:-lerobot/smolvla_base}"
RESULTS_ROOT="${AOE_RESULTS_ROOT:-/PATH_TO/aoe_runs}"
OUTPUT_DIR="${OUTPUT_DIR:-$RESULTS_ROOT/smolvla_open_aoe}"
STEPS="${STEPS:-40000}"
GPUS="${CUDA_VISIBLE_DEVICES:-0}"
RENAME_MAP="${RENAME_MAP:-{\"observation.images.ego\":\"observation.images.camera1\"}}"

export CUDA_VISIBLE_DEVICES="$GPUS"
export PYTHONPATH="$SCRIPT_DIR:${PYTHONPATH:-}"

run_or_print() {
  if [[ "${DRY_RUN:-0}" == "1" ]]; then
    printf '[dry-run]'
    printf ' %q' "$@"
    printf '\n'
  else
    "$@"
  fi
}

# Fast path: reuse pre-decoded aoe26 npz frames, use_videos=False (no SVT-AV1).
convert_data() {
  run_or_print "$PYTHON_BIN" "$SCRIPT_DIR/aoe_npz_to_lerobot.py" \
    --data-root "$RAW_ROOT" \
    --npz-dir "$NPZ_DIR" \
    --out "$DATA_ROOT" \
    --repo-id "$REPO_ID" \
    --dim "$DIM" \
    --max-frames "$MAX_FRAMES"
}

# Slow path: decode raw videos into a video-backed LeRobot v2.1 dataset.
convert_full() {
  local extra=()
  [[ "$DIM" == "26" ]] && extra+=(--append-camera)
  run_or_print "$PYTHON_BIN" "$SCRIPT_DIR/aoe_to_lerobot.py" --full \
    --data-root "$RAW_ROOT" \
    --out "$DATA_ROOT" \
    --repo-id "$REPO_ID" \
    --action-mode delta \
    "${extra[@]}"
}

verify_data() {
  run_or_print "$PYTHON_BIN" "$SCRIPT_DIR/verify_lerobot.py" \
    --repo-id "$REPO_ID" \
    --root "$DATA_ROOT"
}

train_model() {
  local argv=(
    lerobot-train
    --policy.path="$SMOLVLA_BASE"
    --dataset.repo_id="$REPO_ID"
    --dataset.root="$DATA_ROOT"
    --output_dir="$OUTPUT_DIR"
    --policy.push_to_hub=false
    --steps="$STEPS"
    --rename_map="$RENAME_MAP"
  )
  argv+=("$@")
  if [[ "${DRY_RUN:-0}" == "1" ]]; then
    run_or_print "${argv[@]}"
  else
    mkdir -p "$OUTPUT_DIR/logs"
    "${argv[@]}" 2>&1 | tee "$OUTPUT_DIR/logs/smolvla.log"
  fi
}

eval_model() {
  run_or_print "$PYTHON_BIN" "$SCRIPT_DIR/smolvla_eval.py" \
    --policy-path "$OUTPUT_DIR/checkpoints/last/pretrained_model" \
    --dataset-root "$DATA_ROOT" \
    --repo-id "$REPO_ID" \
    --dim "$DIM"
}

plot_curves() {
  run_or_print "$PYTHON_BIN" "$SCRIPT_DIR/plot_loss_curves.py" \
    --input "$OUTPUT_DIR/logs/smolvla.log" \
    --output-dir "$OUTPUT_DIR/loss_curves" \
    --name smolvla
}

cmd="${1:-train}"
shift || true
if [[ "$cmd" == "--dry-run" ]]; then
  DRY_RUN=1
  cmd="${1:-train}"
  shift || true
fi

case "$cmd" in
  convert) convert_data ;;
  convert-full) convert_full ;;
  verify) verify_data ;;
  train) train_model "$@"; plot_curves ;;
  eval) eval_model ;;
  curves) plot_curves ;;
  *) echo "Usage: $0 [--dry-run] {convert|convert-full|verify|train|eval|curves}" >&2; exit 2 ;;
esac

#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
INTEGRATION_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
UPSTREAM_ROOT="${LINGBOT_UPSTREAM_ROOT:-$INTEGRATION_ROOT}"

CONDA_BIN="${CONDA_BIN:-conda}"
CONDA_ENV="${CONDA_ENV:-wam_lingbot_va}"
RAW_ROOT="${OPEN_AOE_RAW_ROOT:-/PATH_TO/general_datasets/Open-AoE/poc_deliver}"
DATA_ROOT="${OPEN_AOE_WAM_ROOT:-/PATH_TO/dataset/Open_AoE/open_aoe_mano_nextstate_224_110d_wam_v2}"
CKPT_ROOT="${CKPT_ROOT:-/PATH_TO/ckpts/HF_ckpts}"
MODEL_ROOT="${LINGBOT_MODEL_PATH:-$CKPT_ROOT/LingBot-VA/lingbot-va-base}"
RESULTS_DIR="${AOE_RESULTS_DIR:-/PATH_TO/aoe_runs/wam_lingbot_open_aoe}"
GPUS="${CUDA_VISIBLE_DEVICES:-0,1,2,3,4,5,6,7}"
NGPU="${NGPU:-8}"
STEPS="${STEPS:-5000}"
SAVE_INTERVAL="${SAVE_INTERVAL:-$STEPS}"

export CUDA_VISIBLE_DEVICES="$GPUS"
export CONFIG_NAME="${CONFIG_NAME:-open_aoe_train}"
export NGPU="$NGPU"
export LINGBOT_ROOT="$UPSTREAM_ROOT"
export LINGBOT_MODEL_PATH="$MODEL_ROOT"
export OPEN_AOE_WAM_ROOT="$DATA_ROOT"
export LINGBOT_STEPS="$STEPS"
export LINGBOT_SAVE_INTERVAL="$SAVE_INTERVAL"
export LINGBOT_TEE="${LINGBOT_TEE:-3}"
export LINGBOT_NUM_INIT_WORKER="${LINGBOT_NUM_INIT_WORKER:-1}"
export LINGBOT_LOAD_WORKER="${LINGBOT_LOAD_WORKER:-0}"
export HF_HOME="${HF_HOME:-$CKPT_ROOT/.cache/huggingface}"
export PYTHONPATH="$UPSTREAM_ROOT:$INTEGRATION_ROOT:${PYTHONPATH:-}"

run_or_print() {
  if [[ "${DRY_RUN:-0}" == "1" ]]; then
    printf '[dry-run]'
    printf ' %q' "$@"
    printf '\n'
  else
    "$@"
  fi
}

convert_data() {
  run_or_print "$CONDA_BIN" run -n "$CONDA_ENV" python "$INTEGRATION_ROOT/scripts/convert_open_aoe_to_wam_v2.py" \
    --input-root "$RAW_ROOT" \
    --output-root "$DATA_ROOT" \
    --limit "${CONVERT_LIMIT:-16}" \
    --max-frames-per-episode "${MAX_FRAMES_PER_EPISODE:-360}" \
    --overwrite
}

prepare_latents() {
  run_or_print "$CONDA_BIN" run -n "$CONDA_ENV" python "$INTEGRATION_ROOT/scripts/prepare_open_aoe_latents.py" \
    --dataset-root "$DATA_ROOT" \
    --model-root "$MODEL_ROOT" \
    --frames "${LINGBOT_FRAMES:-33}" \
    --height "${LINGBOT_HEIGHT:-256}" \
    --width "${LINGBOT_WIDTH:-256}" \
    --device "${LINGBOT_DEVICE:-cuda:0}"
}

train_model() {
  cd "$UPSTREAM_ROOT"
  local argv=(
    "$CONDA_BIN" run --no-capture-output -n "$CONDA_ENV" bash script/run_va_posttrain.sh
    --save-root "$RESULTS_DIR/lingbot_train"
  )
  argv+=("$@")
  if [[ "${DRY_RUN:-0}" == "1" ]]; then
    run_or_print "${argv[@]}"
  else
    mkdir -p "$RESULTS_DIR/logs" "$RESULTS_DIR/lingbot_train"
    "${argv[@]}" 2>&1 | tee "$RESULTS_DIR/logs/train.log"
  fi
}

plot_curves() {
  run_or_print "$CONDA_BIN" run -n "$CONDA_ENV" python "$INTEGRATION_ROOT/scripts/plot_loss_curves.py" \
    --input "$RESULTS_DIR/logs/train.log" \
    --output-dir "$RESULTS_DIR/curves/lingbot" \
    --name lingbot
}

cmd="${1:-train}"
shift || true
if [[ "$cmd" == "--dry-run" ]]; then
  DRY_RUN=1
  cmd="${1:-train}"
  shift || true
fi

case "$cmd" in
  convert) convert_data ;;
  prepare-latents) prepare_latents ;;
  train) prepare_latents; train_model "$@"; plot_curves ;;
  train-only) train_model "$@"; plot_curves ;;
  curves) plot_curves ;;
  *) echo "Usage: $0 [--dry-run] {convert|prepare-latents|train|train-only|curves}" >&2; exit 2 ;;
esac

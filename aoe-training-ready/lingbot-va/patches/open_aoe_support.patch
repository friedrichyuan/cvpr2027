@@ -0,0 +1,83 @@
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+
+from easydict import EasyDict
+
+from .shared_config import va_shared_cfg
+
+
+def _norm_stat(dataset_path: str, action_dim: int) -> dict:
+    path = Path(dataset_path) / "meta" / "open_aoe_action_norm.json"
+    if path.exists():
+        with path.open("r", encoding="utf-8") as f:
+            return json.load(f)
+    return {"q01": [-1.0] * action_dim, "q99": [1.0] * action_dim}
+
+
+def _inverse_channels(used: list[int], action_dim: int) -> list[int]:
+    inverse = [len(used)] * action_dim
+    for out_idx, src_idx in enumerate(used):
+        inverse[src_idx] = out_idx
+    return inverse
+
+
+ACTION_DIM = int(os.environ.get("OPEN_AOE_ACTION_DIM", "110"))
+DATASET_PATH = os.environ.get(
+    "OPEN_AOE_WAM_ROOT",
+    "/PATH_TO/dataset/Open_AoE/open_aoe_mano_nextstate_224_110d_wam_v2",
+)
+MODEL_PATH = os.environ.get(
+    "LINGBOT_MODEL_PATH",
+    "/PATH_TO/ckpts/HF_ckpts/LingBot-VA/lingbot-va-base",
+)
+
+va_open_aoe_train_cfg = EasyDict(__name__="Config: VA Open-AoE train")
+va_open_aoe_train_cfg.update(va_shared_cfg)
+va_open_aoe_train_cfg.infer_mode = "server"
+va_open_aoe_train_cfg.wan22_pretrained_model_name_or_path = MODEL_PATH
+va_open_aoe_train_cfg.dataset_path = DATASET_PATH
+va_open_aoe_train_cfg.empty_emb_path = os.path.join(DATASET_PATH, "empty_emb.pt")
+va_open_aoe_train_cfg.enable_wandb = False
+va_open_aoe_train_cfg.load_worker = int(os.environ.get("LINGBOT_LOAD_WORKER", "4"))
+va_open_aoe_train_cfg.save_interval = int(os.environ.get("LINGBOT_SAVE_INTERVAL", os.environ.get("LINGBOT_STEPS", "50")))
+va_open_aoe_train_cfg.gc_interval = 10
+va_open_aoe_train_cfg.cfg_prob = 0.0
+va_open_aoe_train_cfg.learning_rate = float(os.environ.get("LINGBOT_LR", "1e-5"))
+va_open_aoe_train_cfg.beta1 = 0.9
+va_open_aoe_train_cfg.beta2 = 0.95
+va_open_aoe_train_cfg.weight_decay = 0.1
+va_open_aoe_train_cfg.warmup_steps = 10
+va_open_aoe_train_cfg.batch_size = int(os.environ.get("LINGBOT_BATCH", "1"))
+va_open_aoe_train_cfg.gradient_accumulation_steps = int(os.environ.get("LINGBOT_GRAD_ACCUM", "1"))
+va_open_aoe_train_cfg.num_steps = int(os.environ.get("LINGBOT_STEPS", "50"))
+va_open_aoe_train_cfg.attn_window = 30
+va_open_aoe_train_cfg.frame_chunk_size = 4
+va_open_aoe_train_cfg.env_type = "none"
+va_open_aoe_train_cfg.height = 256
+va_open_aoe_train_cfg.width = 256
+va_open_aoe_train_cfg.action_dim = ACTION_DIM
+va_open_aoe_train_cfg.action_per_frame = 4
+va_open_aoe_train_cfg.obs_cam_keys = ["observation.images.front"]
+va_open_aoe_train_cfg.guidance_scale = 5
+va_open_aoe_train_cfg.action_guidance_scale = 1
+va_open_aoe_train_cfg.num_inference_steps = 5
+va_open_aoe_train_cfg.video_exec_step = -1
+va_open_aoe_train_cfg.action_num_inference_steps = 10
+va_open_aoe_train_cfg.snr_shift = 5.0
+va_open_aoe_train_cfg.action_snr_shift = 1.0
+va_open_aoe_train_cfg.used_action_channel_ids = list(range(ACTION_DIM))
+va_open_aoe_train_cfg.inverse_used_action_channel_ids = _inverse_channels(
+    va_open_aoe_train_cfg.used_action_channel_ids, ACTION_DIM
+)
+va_open_aoe_train_cfg.action_norm_method = "quantiles"
+va_open_aoe_train_cfg.norm_stat = _norm_stat(DATASET_PATH, ACTION_DIM)
+
+va_open_aoe_i2va_cfg = EasyDict(__name__="Config: VA Open-AoE i2va")
+va_open_aoe_i2va_cfg.update(va_open_aoe_train_cfg)
+va_open_aoe_i2va_cfg.infer_mode = "i2va"
+va_open_aoe_i2va_cfg.input_img_path = os.environ.get("LINGBOT_INPUT_IMG_PATH", "")
+va_open_aoe_i2va_cfg.prompt = os.environ.get("LINGBOT_PROMPT", "egocentric hand manipulation")
+va_open_aoe_i2va_cfg.num_chunks_to_infer = int(os.environ.get("LINGBOT_NUM_CHUNKS", "2"))

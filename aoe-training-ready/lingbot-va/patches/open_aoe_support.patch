+def resize_action_layers(transformer: nn.Module, action_dim: int) -> None:
+    embedder = getattr(transformer, "action_embedder", None)
+    if isinstance(embedder, nn.Linear) and embedder.in_features != action_dim:
+        new_embedder = nn.Linear(
+            action_dim,
+            embedder.out_features,
+            bias=embedder.bias is not None,
+            device=embedder.weight.device,
+            dtype=embedder.weight.dtype,
+        )
+        with torch.no_grad():
+            new_embedder.weight.zero_()
+            keep = min(embedder.in_features, action_dim)
+            new_embedder.weight[:, :keep].copy_(embedder.weight[:, :keep])
+            if embedder.bias is not None:
+                new_embedder.bias.copy_(embedder.bias)
+        transformer.action_embedder = new_embedder
+
+    proj_out = getattr(transformer, "action_proj_out", None)
+    if isinstance(proj_out, nn.Linear) and proj_out.out_features != action_dim:
+        new_proj_out = nn.Linear(
+            proj_out.in_features,
+            action_dim,
+            bias=proj_out.bias is not None,
+            device=proj_out.weight.device,
+            dtype=proj_out.weight.dtype,
+        )
+        with torch.no_grad():
+            new_proj_out.weight.zero_()
+            keep = min(proj_out.out_features, action_dim)
+            new_proj_out.weight[:keep].copy_(proj_out.weight[:keep])
+            if proj_out.bias is not None:
+                new_proj_out.bias.zero_()
+                new_proj_out.bias[:keep].copy_(proj_out.bias[:keep])
+        transformer.action_proj_out = new_proj_out
+
